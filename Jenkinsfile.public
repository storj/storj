pipeline {
    // The agent is set on the Public stage, so a build can be retried on a new
    // VM when its Spot agent is preempted.
    agent none
    options {
        timeout(time: 4, unit: 'HOURS')
        skipDefaultCheckout(true)
    }
    environment {
        NPM_CONFIG_CACHE = '/npm/cache'
        GOTRACEBACK = 'all'
    }
    stages {
        stage('Public') {
            agent {
                docker {
                    label 'main'
                    image 'storjlabs/ci:latest'
                    alwaysPull true
                    args '-u root:root --cap-add SYS_PTRACE -v "/cache/gomod":/go/pkg/mod -v /cache/golangci-lint:/root/.cache/golangci-lint -v /cache/staticcheck:/root/.cache/staticcheck -v /cache/ms-playwright:/root/.cache/ms-playwright -v /cache/gobuild:/root/.cache/go-build -v /cache/gobenchmarks:/root/.cache/go-build-benchmarks -v /cache/gomain:/root/.cache/go-build-main -v "/cache/npm":/npm'
                }
            }
            options {
                retry(count: 3, conditions: [agent(), nonresumable()])
            }
            stages {
                stage('Checkout') {
                    steps {
                        // Delete any content left over from a previous run.
                        sh "chmod -R 777 ."
                        // Bash requires extglob option to support !(.git) syntax,
                        // and we don't want to delete .git to have faster clones.
                        sh 'bash -O extglob -c "rm -rf !(.git)"'

                        checkout scm

                        sh 'mkdir -p .build'
                        sh 'git restore-mtime'

                        // download dependencies
                        sh 'go mod download'

                        // pre-check that we cannot do at a later stage reliably
                        sh 'check-large-files'
                    }
                }
                stage('Build Web') {
                    // The build code depends on the following assets being loaded.
                    parallel {
                        stage('web/satellite') {
                            steps {
                                sh './web/satellite/check-and-build.sh'
                            }
                        }

                        stage('web/storagenode') {
                            steps {
                                sh './web/storagenode/check-and-build.sh'
                            }
                        }

                        stage('web/multinode') {
                            steps {
                                sh './web/multinode/check-and-build.sh'
                            }
                        }

                        stage('db') {
                            steps {
                                sh 'service postgresql start'
                            }
                        }
                    }
                }

                stage('Lint') {
                    parallel {
                        stage('Lint') {
                            steps {
                                sh 'make llint'
                            }
                        }
                        stage('Additional checks') {
                            steps {
                                sh './scripts/check-package-lock.sh'
                                dir("testsuite/storjscan") {
                                    sh 'go vet ./...'
                                }
                            }

                        }
                        stage('licenses check') {
                            steps {
                                // go-licenses by default has AGPL3 in the forbidden list, hence we need to explicitly allow `storj.io/storj`.
                                // note: json-iterator is replaced by our stub, it should be ignored as storj.io/storj.
                                sh 'go-licenses check --ignore "storj.io/storj" --ignore "github.com/json-iterator/go" ./...'
                            }
                        }
                    }
                }

                stage('Build') {
                    parallel {
                        stage('go -race') {
                            steps {
                                // install storj-sim and gateway, the integration tests reuse these binaries
                                sh 'make install-sim'
                            }
                        }

                        stage('Cross Compile') {
                            steps {
                                // verify most of the commands, we cannot check everything since some of them
                                // have a C dependency and we don't have cross-compilation in storj/ci image
                                sh 'check-cross-compile storj.io/storj/cmd/uplink storj.io/storj/cmd/satellite storj.io/storj/cmd/storagenode-updater storj.io/storj/cmd/storj-sim'
                            }
                        }

                        stage('Check Benchmark') {
                            environment {
                                STORJ_TEST_COCKROACH = 'omit'
                                STORJ_TEST_POSTGRES = 'postgres://postgres@localhost/benchstorj?sslmode=disable'
                                STORJ_TEST_TIDB = 'omit'

                                GOCACHE = '/root/.cache/go-build-benchmarks'
                            }
                            steps {
                                sh 'psql -U postgres -c \'create database benchstorj;\''
                                sh 'go test -parallel 1 -p 16 -vet=off -timeout 60m -short -run XYZXYZXYZXYZ -bench . -benchtime 1x ./...'
                            }
                        }

                        stage('Test web/satellite') {
                            steps {
                                dir("web/satellite") {
                                    sh 'npm run lint-ci'
                                    sh script: 'npm audit', returnStatus: true
                                    sh 'npm run test'
                                    sh 'npm run test-wasm'
                                }
                            }
                        }

                        stage('Test web/storagenode') {
                            steps {
                                dir("web/storagenode") {
                                    sh 'npm run lint-ci'
                                    sh script: 'npm audit', returnStatus: true
                                    sh 'npm run test'
                                }
                            }
                        }

                        stage('Test web/multinode') {
                            steps {
                                dir("web/multinode") {
                                    sh 'npm run lint-ci'
                                    sh script: 'npm audit', returnStatus: true
                                    sh 'npm run test'
                                }
                            }
                        }

                        stage('Test satellite/admin/ui') {
                            steps {
                                dir("satellite/admin/ui") {
                                    sh 'npm install --prefer-offline --no-audit --loglevel verbose'
                                    sh 'npm run lint-ci'
                                    sh 'npm run type-check'
                                    sh script: 'npm audit', returnStatus: true
                                }
                            }
                        }
                    }
                }

                stage('Tests') {
                    parallel {
                        stage('Tests') {
                            environment {
                                STORJ_TEST_HOST = '127.0.0.20;127.0.0.21;127.0.0.22;127.0.0.23;127.0.0.24;127.0.0.25'
                                STORJ_TEST_LOG_LEVEL = 'info'

                                STORJ_TEST_COCKROACH = 'omit'
                                STORJ_TEST_POSTGRES = 'postgres://postgres@localhost/teststorj?sslmode=disable'
                                STORJ_TEST_TIDB = 'tidb://root@127.0.0.1:4000/storj?parseTime=true!!master=postgres://postgres@localhost/tidb?sslmode=disable'

                                STORJ_HASHSTORE_TABLE_DEFAULT_KIND = 'memtbl'
                                COVERFLAGS = "${ env.BRANCH_NAME == 'main' ? '-coverprofile=.build/coverprofile -coverpkg=./...' : ''}"
                            }
                            steps {
                                // start tidb databases — must come before `use-ports` so tidb (4000)
                                // owns its port; otherwise use-ports binds it and clients hang waiting
                                // for a server greeting that never comes.
                                sh 'psql -U postgres -c \'create database tidb;\''
                                sh 'psql -U postgres -c \'create database teststorj;\''
                                // tidb.toml's bootstrap-sql-file points at /etc/tidb-init.sql for the
                                // docker-compose flow; rewrite it to the workspace path for tiup, which
                                // runs tidb-server out of ~/.tiup/data/.../tidb-0 (no /etc mount).
                                sh 'sed "s|/etc/tidb-init.sql|$WORKSPACE/testsuite/tidb-init.sql|" testsuite/tidb.toml > .build/tidb.toml'
                                // --tag storj fixes the data dir at ~/.tiup/data/storj so the
                                // per-component logs (tidb-0/tidb.log etc.) are at a known path to
                                // archive when a component dies mid-run.
                                // The version must match TIDB_VERSION in storj/ci images/deps.sh, otherwise
                                // tiup downloads the latest components (~1GB) on every build. TiFlash is
                                // not used by tests.
                                sh 'nohup tiup playground v8.5.6 --tiflash 0 --tag storj --db.config .build/tidb.toml --without-monitor >.build/tiup.log 2>&1 &'
                                // bootstrap-sql-file runs before TiDB opens the SQL port, so a TCP
                                // probe on 4000 is sufficient — and avoids `tiup playground display`
                                // hanging when the playground manager socket isn't ready.
                                sh 'timeout 180 bash -c "until : >/dev/tcp/127.0.0.1/4000 2>/dev/null; do sleep 1; done"'

                                // Record TiDB liveness + memory once a second for the whole run so a
                                // mid-test `connection refused` can be correlated with the exact
                                // moment tidb-server stopped listening (and whether it was OOM).
                                sh '''nohup bash -c 'while sleep 1; do
                  if : >/dev/tcp/127.0.0.1/4000 2>/dev/null; then st=UP; else st=DOWN; fi
                  printf "%s port4000=%s tidb_pids=[%s] mem=%s\\n" "$(date -Ins)" "$st" \
                    "$(pgrep -d, -f tidb-server)" "$(free -m | awk "/Mem:/{print \\$3\\"/\\"\\$2}")"
                done' > .build/tidb-monitor.log 2>&1 &'''

                                sh 'use-ports -from 1024 -to 10000 &'

                                sh 'go test -parallel 9 -p 12 -vet=off $COVERFLAGS -timeout 60m -json -race ./... 2>&1 | tee .build/tests.json | xunit -out .build/tests.xml'
                            }

                            post {
                                always {
                                    // Collect tidb-server's own logs and any kernel OOM evidence so a
                                    // crash/OOM can be diagnosed after the fact. Tar only the *.log
                                    // files — archiving the raw data dir fails on TiKV rocksdb blobs
                                    // and unix sockets. dmesg may be restricted, hence returnStatus.
                                    sh script: 'tar -czf .build/tiup-logs.tar.gz -C $HOME/.tiup/data/storj $(cd $HOME/.tiup/data/storj && find . -name "*.log") 2>/dev/null; dmesg -T 2>/dev/null | grep -iE "oom|killed process|tidb-server" | tail -50 > .build/oom.log', returnStatus: true
                                    archiveArtifacts artifacts: '.build/tests.json'
                                    archiveArtifacts artifacts: '.build/tiup.log'
                                    archiveArtifacts artifacts: '.build/tidb-monitor.log', allowEmptyArchive: true
                                    archiveArtifacts artifacts: '.build/tiup-logs.tar.gz', allowEmptyArchive: true
                                    archiveArtifacts artifacts: '.build/oom.log', allowEmptyArchive: true
                                    sh script: 'cat .build/tests.json | tparse -all -slow 100 -sort elapsed', returnStatus: true
                                    junit '.build/tests.xml'

                                    script {
                                        if(fileExists(".build/coverprofile")){
                                            sh script: 'filter-cover-profile < .build/coverprofile > .build/clean.coverprofile', returnStatus: true
                                            archiveArtifacts artifacts: '.build/clean.coverprofile'
                                            recordCoverage(
                                                tools: [[parser: 'GO_COV', pattern: '.build/clean.coverprofile']],
                                                sourceCodeRetention: 'NEVER',
                                            )
                                        }
                                    }
                                }
                            }
                        }

                        stage('Satellite UI Tests') {
                            environment {
                                STORJ_TEST_COCKROACH = 'omit'
                                STORJ_TEST_POSTGRES = 'postgres://postgres@localhost/uitestpostgres?sslmode=disable'
                                STORJ_TEST_TIDB = 'omit'
                                STORJ_TEST_LOG_LEVEL = 'debug'
                            }

                            steps {
                                sh 'psql -U postgres -c \'create database uitestpostgres;\''
                                sh 'make test/integration/ui'

                                dir('web/satellite/wasm') {
                                    sh 'go vet ./...'
                                    sh 'go test ./...'
                                }
                            }

                            post {
                                failure {
                                    sh script: 'tar -zcvf .build/test-results.tar.gz ./testsuite/playwright-ui/test-results/'
                                    archiveArtifacts artifacts: '.build/test-results.tar.gz'
                                }
                            }
                        }
                    }
                }

                // The storj-sim tests are kept apart from the build stages above,
                // because they are timing sensitive. Backwards Compatibility still
                // compiles the release and branch binaries while the other two run.
                // Each one uses its own host and database.
                stage('Integration') {
                    parallel {
                        stage('Postgres') {
                            environment {
                                // use different hostname to avoid port conflicts
                                STORJ_NETWORK_HOST4 = '127.0.0.2'
                                STORJ_NETWORK_HOST6 = '127.0.0.2'

                                STORJ_SIM_POSTGRES = 'postgres://postgres@localhost/teststorj2?sslmode=disable'
                            }

                            steps {
                                sh 'psql -U postgres -c \'create database teststorj2;\''
                                sh 'make test-sim'

                                // sh 'make test-certificates' // flaky
                            }
                        }

                        stage('Backwards Compatibility') {
                            environment {
                                STORJ_NETWORK_HOST4 = '127.0.0.3'
                                STORJ_NETWORK_HOST6 = '127.0.0.3'

                                STORJ_SIM_POSTGRES = 'postgres://postgres@localhost/teststorj3?sslmode=disable'
                                STORJ_MIGRATION_DB = 'postgres://postgres@localhost/teststorj3?sslmode=disable&options=--search_path=satellite/0/meta'

                                STORJ_CONSOLE_SIGNUP_ACTIVATION_CODE_ENABLED = 'false'
                            }

                            steps {
                                sh 'psql -U postgres -c \'create database teststorj3;\''
                                sh 'make test-sim-backwards-compatible'
                            }
                        }

                        stage('Redis unavailability') {
                            environment {
                                // use different hostname to avoid port conflicts
                                STORJ_NETWORK_HOST4 = '127.0.0.6'
                                STORJ_NETWORK_HOST6 = '127.0.0.6'
                                STORJ_REDIS_PORT = '7379'

                                STORJ_SIM_POSTGRES = 'postgres://postgres@localhost/teststorj6?sslmode=disable'
                            }

                            steps {
                                sh 'psql -U postgres -c \'create database teststorj6;\''
                                sh 'make test-sim-redis-unavailability'
                            }
                        }
                    }
                }

                stage('Post') {
                    parallel {
                        stage('Lint') {
                            steps {
                                sh 'check-clean-directory'
                            }
                        }
                    }
                }
            }
        }
    }
}
