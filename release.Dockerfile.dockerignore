# ignore dot files
**/.vscode
**/.idea
# local settings would otherwise be an untracked file inside the build, which
# makes every binary report vcs.modified=true
**/.claude/settings.local.json

# except git files
!.git*

# ignore temporary files
**/*~
/*.swp

# ignore built releases
release/

# ignore node specific folders
**/node_modules
web/*/{build,dist,coverage}/
satellite/admin/ui/{build,dist,coverage}/
