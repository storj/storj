# syntax=docker/dockerfile:1.4-labs
# Builds the uplinks for stable-versions.txt, see `make test/uplink-versions/publish-binaries`.
ARG GO_VERSION="1.26.6"

# go1.16 crashes under emulation, so build natively and cross-compile for linux/amd64, which is what Jenkins runs.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build

ARG GOPROXY
ENV GOPROXY=${GOPROXY}

RUN go install golang.org/dl/go1.16.15@latest && go1.16.15 download
ENV GOOS=linux GOARCH=amd64 CGO_ENABLED=0

COPY .git /src/.git
COPY testsuite/uplink-versions/stable-versions.txt /src/

# the output layout must match bin_cache_dir in start-sim.sh
RUN set -e; for version in $(cat /src/stable-versions.txt); do \
        git -C /src worktree add -f /build/$version $version; \
        cd /build/$version; \
        rm -f internal/version/release.go; \
        go1.16.15 build -trimpath -ldflags=-s -o /out/$version-$(go1.16.15 env GOVERSION)-$(go1.16.15 env GOARCH)/uplink storj.io/storj/cmd/uplink; \
    done

FROM scratch
COPY --from=build /out /
